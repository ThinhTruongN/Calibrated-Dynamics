<mujoco model="paper triple pendulum balance">
    <compiler angle="radian" autolimits="true"/>

    <!-- The paper uses a 20 ms simulation and control interval. -->
    <option timestep="0.02" gravity="0 0 -9.81" integrator="implicitfast"/>

    <visual>
        <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7"/>
    </visual>

    <default>
        <geom contype="0" conaffinity="0"/>
        <site type="sphere" size="0.025"/>
    </default>

    <worldbody>
        <light pos="0 -4 6"/>
        <camera name="side" pos="0 -12 2" xyaxes="1 0 0 0 0 1"/>

        <geom name="floor" type="plane" pos="0 0 -0.35" size="7 3 0.1"
              mass="0" rgba="0.9 0.9 0.9 1"/>
        <geom name="rail" type="box" pos="0 0 0.02" size="5.7 0.04 0.04"
              mass="0" rgba="0.25 0.25 0.28 1"/>

        <body name="cart" pos="0 0 0.25">
            <joint name="cart_slide" type="slide" axis="1 0 0" limited="false"/>
            <inertial pos="0 0 -0.12" mass="1.0" diaginertia="0.1 0.1 0.1"/>
            <geom name="cart_body" type="box" pos="0 0 -0.12"
                  size="0.28 0.18 0.12" mass="0" rgba="0.18 0.18 0.2 1"/>
            <site name="cart_pivot" pos="0 0 0" rgba="1 0.8 0.1 1"/>

            <!-- qpos = [cart_x, 0, 0, 0] is the upright equilibrium. -->
            <body name="link1" pos="0 0 0">
                <joint name="joint1" type="hinge" axis="0 1 0"/>
                <inertial pos="0 0 0.5" mass="0.1"
                          diaginertia="0.0083333333 0.0083333333 0.0001"/>
                <geom name="rod1" type="capsule" fromto="0 0 0 0 0 1"
                      size="0.035" mass="0" rgba="0.9 0.2 0.2 1"/>
                <site name="link1_endpoint" pos="0 0 1" rgba="1 0.8 0.1 1"/>

                <body name="link2" pos="0 0 1">
                    <joint name="joint2" type="hinge" axis="0 1 0"/>
                    <inertial pos="0 0 0.5" mass="0.1"
                              diaginertia="0.0083333333 0.0083333333 0.0001"/>
                    <geom name="rod2" type="capsule" fromto="0 0 0 0 0 1"
                          size="0.035" mass="0" rgba="0.2 0.7 0.3 1"/>
                    <site name="link2_endpoint" pos="0 0 1" rgba="1 0.8 0.1 1"/>

                    <body name="link3" pos="0 0 1">
                        <joint name="joint3" type="hinge" axis="0 1 0"/>
                        <inertial pos="0 0 0.5" mass="0.1"
                                  diaginertia="0.0083333333 0.0083333333 0.0001"/>
                        <geom name="rod3" type="capsule" fromto="0 0 0 0 0 1"
                              size="0.035" mass="0" rgba="0.2 0.4 0.9 1"/>
                        <site name="link3_endpoint" pos="0 0 1"
                              rgba="1 0.8 0.1 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- Actions select exactly -60 N or +60 N on the cart. -->
        <motor name="cart_motor" joint="cart_slide" gear="1"
               ctrllimited="true" ctrlrange="-60 60"
               forcelimited="true" forcerange="-60 60"/>
    </actuator>
</mujoco>
