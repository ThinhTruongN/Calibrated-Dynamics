<mujoco model="cart triple pendulum">
    <compiler angle="radian" autolimits="true"/>

    <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>

    <visual>
        <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7"/>
    </visual>

    <default>
        <geom type="capsule" size="0.05" mass="0.2"/>
        <site type="sphere" size="0.025"/>
    </default>

    <worldbody>
        <light pos="0 -3 6"/>
        <camera name="side" pos="0 -9 2.7" xyaxes="1 0 0 0 0 1"/>

        <geom
            name="floor"
            type="plane"
            size="6 4 0.1"
            mass="0"
            rgba="0.9 0.9 0.9 1"
        />
        <geom
            name="rail"
            type="box"
            pos="0 0 2.84"
            size="2.8 0.04 0.04"
            mass="0"
            contype="0"
            conaffinity="0"
            rgba="0.25 0.25 0.28 1"
        />

        <body name="cart" pos="0 0 2.7">
            <joint
                name="cart_slide"
                type="slide"
                axis="1 0 0"
                range="-2.5 2.5"
                damping="0.2"
                frictionloss="0.02"
                armature="0.02"
            />
            <geom
                name="cart_body"
                type="box"
                pos="0 0 0.14"
                size="0.25 0.18 0.12"
                mass="1.0"
                rgba="0.18 0.18 0.2 1"
            />
            <site name="cart_pivot" pos="0 0 0" rgba="1 0.8 0.1 1"/>

            <body name="link1" pos="0 0 0">
                <joint
                    name="joint1"
                    type="hinge"
                    axis="0 1 0"
                    damping="0.03"
                    frictionloss="0.002"
                    armature="0.002"
                />
                <geom
                    name="rod1"
                    fromto="0 0 0 0 0 -0.8"
                    rgba="0.9 0.2 0.2 1"
                />
                <site name="link1_endpoint" pos="0 0 -0.8" rgba="1 0.8 0.1 1"/>

                <body name="link2" pos="0 0 -0.8">
                    <joint
                        name="joint2"
                        type="hinge"
                        axis="0 1 0"
                        damping="0.03"
                        frictionloss="0.002"
                        armature="0.002"
                    />
                    <geom
                        name="rod2"
                        fromto="0 0 0 0 0 -0.8"
                        rgba="0.2 0.7 0.3 1"
                    />
                    <site name="link2_endpoint" pos="0 0 -0.8" rgba="1 0.8 0.1 1"/>

                    <body name="link3" pos="0 0 -0.8">
                        <joint
                            name="joint3"
                            type="hinge"
                            axis="0 1 0"
                            damping="0.03"
                            frictionloss="0.002"
                            armature="0.002"
                        />
                        <geom
                            name="rod3"
                            fromto="0 0 0 0 0 -0.8"
                            rgba="0.2 0.4 0.9 1"
                        />
                        <site name="link3_endpoint" pos="0 0 -0.8" rgba="1 0.8 0.1 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- All three pendulum hinges are passive. -->
        <motor
            name="cart_motor"
            joint="cart_slide"
            gear="1"
            ctrllimited="true"
            ctrlrange="-10 10"
            forcelimited="true"
            forcerange="-10 10"
        />
    </actuator>
</mujoco>
