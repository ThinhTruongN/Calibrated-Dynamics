<mujoco model="single pendulum">
    <option timestep="0.01" gravity="0 0 -9.81"/>

    <worldbody>
        <light pos="0 0 3"/>

        <geom
            type="plane"
            size="3 3 0.1"
            rgba="0.9 0.9 0.9 1"
        />

        <body name="pendulum" pos="0 0 1.5">
            <joint
                name="hinge"
                type="hinge"
                axis="0 1 0"
                damping="0.05"
            />

            <geom
                name="rod"
                type="capsule"
                fromto="0 0 0 0 0 -1"
                size="0.05"
                density="500"
                rgba="0.2 0.5 0.9 1"
            />
        </body>
    </worldbody>

    <actuator>
        <motor
            name="hinge_motor"
            joint="hinge"
            ctrllimited="true"
            ctrlrange="-3 3"
        />
    </actuator>
</mujoco>